{
  "name": "niche-scope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev --webpack",
    "dev:full": "concurrently -n web,poller -c cyan,magenta \"next dev --webpack\" \"tsx scripts/poller.ts\"",
    "poller": "tsx scripts/poller.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "node scripts/backup.ts backup",
    "restore-backup": "node scripts/backup.ts restore"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
