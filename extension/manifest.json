{
  "manifest_version": 3,
  "name": "Niche-Scope",
  "version": "0.3.0",
  "description": "Always-on SEO scores, letter grades and views-per-hour on every YouTube card, backed by your local Niche-Scope server.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Niche-Scope"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["lib/nsMeta.js", "content.js"],
      "css": ["ns-theme.css", "content.css"],
      "run_at": "document_idle"
    }
  ]
}
